FROM python:3.12-slim
WORKDIR /app
COPY requirements-monitor.txt .
RUN pip install --no-cache-dir -r requirements-monitor.txt
COPY monitor.py monitor_contract.py monitor_worker.py monitor_drill.py ./
COPY docs/data.json ./docs/data.json
ENV PYTHONUNBUFFERED=1 MONITOR_STATE=/state/monitor.sqlite
CMD ["timeout", "120s", "python", "monitor_worker.py"]
